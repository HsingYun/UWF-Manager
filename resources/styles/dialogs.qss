QDialog[uwfDialog="true"] {
    background: @window@;
    color: @text@;
}
QDialog[designDialogSurface="true"] { background: transparent; }

QLabel[dialogTone="muted"] { color: @muted@; }
QLineEdit[dialogPath="true"] { color: @muted@; background: transparent; border: none; padding: 0; }
QTextBrowser[dialogTone="muted"] { color: @muted@; }
